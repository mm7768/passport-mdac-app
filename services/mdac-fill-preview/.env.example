# Runtime and safety variables. Enter these only in Railway Variables.
SUPABASE_URL=https://xdmcxhvdqsbcqedfprcy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-railway-only
MDAC_WORKER_ID=railway-mdac-fill-preview
MDAC_EXECUTION_MODE=FILL_PREVIEW
ALLOW_REAL_SUBMIT=false
MDAC_URL=https://imigresen-online.imi.gov.my/mdac/main?registerMain
MDAC_POLL_SECONDS=15
MDAC_LEASE_SECONDS=900
MDAC_MAX_ATTEMPTS=5
SUPABASE_REQUEST_TIMEOUT_SECONDS=30
MDAC_PAGE_TIMEOUT_MS=60000
MDAC_HEADLESS=true
LOG_LEVEL=INFO

# Screenshot storage configuration only; the bucket remains private.
MDAC_SCREENSHOT_BUCKET=passport-documents
MDAC_SCREENSHOT_PREFIX=mdac-previews

# Contact, travel, embarkation, vessel, accommodation, address, location,
# postcode and POB mode are no longer Railway variables.
# They are edited in the Flutter App and copied into each queued batch snapshot.
