# Supabase service-role credentials: enter only in Railway Variables.
SUPABASE_URL=https://xdmcxhvdqsbcqedfprcy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Hard safety boundary. The worker refuses every other value.
MDAC_EXECUTION_MODE=FILL_PREVIEW
ALLOW_REAL_SUBMIT=false
MDAC_WORKER_ID=railway-mdac-fill-preview
MDAC_URL=https://imigresen-online.imi.gov.my/mdac/main?registerMain
MDAC_POLL_SECONDS=15
MDAC_LEASE_SECONDS=900
MDAC_MAX_ATTEMPTS=5
SUPABASE_REQUEST_TIMEOUT_SECONDS=30
MDAC_PAGE_TIMEOUT_MS=60000
MDAC_HEADLESS=true
LOG_LEVEL=INFO

# Fixed MDAC application data: enter only in Railway Variables.
MDAC_EMAIL=
MDAC_PHONE=
MDAC_REGION_CODE=60
MDAC_TRAVEL_MODE=2
MDAC_EMBARK_COUNTRY=CHN
MDAC_VESSEL=
MDAC_ACCOMMODATION_STAY=02
MDAC_ADDRESS1=
MDAC_ADDRESS2=
MDAC_STATE=01
MDAC_CITY=0100
MDAC_POSTCODE=

# The current official page uses nationality for Place of Birth in the legacy flow.
# Set CUSTOMER only if the business rule is explicitly confirmed later.
MDAC_POB_MODE=NATIONALITY
MDAC_SCREENSHOT_BUCKET=passport-documents
MDAC_SCREENSHOT_PREFIX=mdac-previews
