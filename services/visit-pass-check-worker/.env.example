# Required Railway secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-railway-secret

# Worker identity and hard safety gates
VISIT_PASS_CHECK_WORKER_ID=railway-visit-pass-check
VISIT_PASS_CHECK_MODE=FILL_REVIEW
ALLOW_REAL_SUBMIT=false
VISIT_PASS_CHECK_HEADLESS=true

# Official public page and runtime tuning
VISIT_PASS_CHECK_URL=https://imigresen-online.imi.gov.my/mdac/register?viewVisitPass
VISIT_PASS_CHECK_POLL_SECONDS=30
VISIT_PASS_CHECK_LEASE_SECONDS=900
VISIT_PASS_CHECK_MAX_ATTEMPTS=5
SUPABASE_REQUEST_TIMEOUT_SECONDS=30
VISIT_PASS_CHECK_PAGE_TIMEOUT_MS=60000

# Private review artifact storage
VISIT_PASS_CHECK_SCREENSHOT_BUCKET=passport-documents
VISIT_PASS_CHECK_SCREENSHOT_PREFIX=visit-pass-check-previews
LOG_LEVEL=INFO

# Gmail address and App Password are not Railway variables.
# They are managed by the Flutter App/Supabase Vault flow.
